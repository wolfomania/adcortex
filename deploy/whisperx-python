#!/bin/sh
# Python of the WhisperX environment, with the cuDNN and cuBLAS libraries that
# its torch wheels ship on the library path. CTranslate2 (faster-whisper) loads
# them by name and does not look inside site-packages on its own.
nvidia=/opt/whisperx/lib/python3.12/site-packages/nvidia
export LD_LIBRARY_PATH="$nvidia/cudnn/lib:$nvidia/cublas/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec /opt/whisperx/bin/python "$@"
