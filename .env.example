# Copy to .env and fill in what you need. `make dev` and `make deploy` read it.
# .env is git-ignored: keep keys there and nowhere else.

# ── Report model (optional) ─────────────────────────────────────────────────
# Any Pydantic AI model that accepts images and returns structured output:
#   google:gemini-4-hydrogen     needs GOOGLE_API_KEY
#   anthropic:claude-opus-5-5    needs ANTHROPIC_API_KEY
#   openai:<model>               needs OPENAI_API_KEY
# Leave it empty to get the metrics without a written report.
NM_LLM_MODEL=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# What the report model sees: video (the clip itself), keyframes, or text
# (metrics only). On free tiers, providers may use what you send to improve
# their products.
NM_LLM_MEDIA=video
# How the model returns the report: tool, native, or prompted.
NM_LLM_OUTPUT_MODE=tool

# ── Access (optional) ───────────────────────────────────────────────────────
# Set a password to require a login. Share links work without it.
NM_PASSWORD=
# Signs sessions and share links. Empty: a random key is kept in storage.
NM_SECRET_KEY=

# ── Modal deployment ────────────────────────────────────────────────────────
# A Hugging Face token whose account accepted the Llama 3.2 license
# (https://huggingface.co/meta-llama/Llama-3.2-3B). TRIBE v2 reads text with it.
# Used to download the models.
HF_TOKEN=

# ── Local development ───────────────────────────────────────────────────────
# mock: instant synthetic responses. replay: a recorded TRIBE v2 run.
# tribe: the real model (needs a GPU). Modal deployments always use tribe.
NM_BRAIN_BACKEND=mock

# ── Limits ──────────────────────────────────────────────────────────────────
# NM_MIN_DURATION_S=3
# NM_MAX_DURATION_S=180
# NM_MAX_UPLOAD_MB=500
